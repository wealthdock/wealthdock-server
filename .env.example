# Copy this file to .env and adjust values for your environment.
# These defaults match the services defined in docker-compose.yml.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# POSTGRES_PASSWORD is required by docker-compose.yml. Change it before exposing
# this instance; the value must be percent-encoded if it contains @ : / or #.
POSTGRES_PASSWORD=wealthdock
# Used when running the server directly on the host. Under docker compose the
# app and migration services build DATABASE_URL from POSTGRES_PASSWORD instead,
# pointing at the "postgres" service rather than localhost.
DATABASE_URL=postgresql+asyncpg://wealthdock:wealthdock@localhost:5432/wealthdock

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Allowed Origins ---
# Comma-separated, or a JSON array. Required by docker-compose.yml.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Encryption ---
# ENCRYPTION_KEY is required and has no default: the app and the migration step
# both fail to start without it. It must be a 32-byte, url-safe, base64 key.
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gkjtJ2MZF1v-2HRnQ3SZmrYQ6HsyRO5prWEFBdnpDeY=


